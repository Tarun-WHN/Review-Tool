{
  "name": "warehouse-now-review-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Warehouse Now Team Review & Task Monitoring Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "seed": "npm --workspace server run seed",
    "migrate:deploy": "npm --workspace server run migrate:deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
