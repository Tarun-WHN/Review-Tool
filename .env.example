# ---- Server ----
# PostgreSQL connection string (Render injects this automatically in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/review_tool?schema=public"

# JWT signing secret — change this to a long random string
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Port the API listens on (Render sets PORT automatically)
PORT=4000

# CORS: comma-separated list of allowed client origins. Use * for any (dev only).
CLIENT_ORIGIN="http://localhost:5173"

# ---- Seed admin user (created/updated by the seed script) ----
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@warehousenow.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- Client (Vite) ----
# Base URL of the API the client talks to. Leave blank to use same-origin "/api".
VITE_API_BASE_URL="http://localhost:4000"
